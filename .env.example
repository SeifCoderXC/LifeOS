# Firebase (Firestore) — the database. Firebase console -> Project settings ->
# Service accounts -> Generate new private key. Never commit these.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gemini — free AI-powered extraction for every user, no billing account required.
# Get a key at https://aistudio.google.com/apikey. Without this, users fall back to
# the local heuristic parser instead of "Smart Mode".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# xAI / Grok — never commit the real key. Get one at https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4.6

# Deep Mode (Grok extraction + live web research) is metered and invite-only at launch.
# Comma-separated emails allowed to use it; everyone else gets Smart Mode (Gemini) or,
# if GEMINI_API_KEY isn't set, the free local heuristic parser.
OWNER_EMAIL=
DEEP_MODE_ALLOWLIST=
DEEP_MODE_MONTHLY_LIMIT=300

# Optional: transactional email for password-reset links (Resend — https://resend.com).
# Without this, reset links are printed to the server console and shown as a dev
# shortcut in the browser — fine for local testing, required before a real launch.
RESEND_API_KEY=
EMAIL_FROM="LifeOS <onboarding@resend.dev>"
